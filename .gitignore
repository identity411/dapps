data/
relay/data/
*.db
*.db-shm
*.db-wal

# Stage 0 local Steam helper session (sensitive)
.steam-helper-session.json
.steam-helper-qr.*

# S1 seller-local helper state (helper token, Steam refresh token, QR, ledger)
helper/.skinpact-helper/
.skinpact-helper/
