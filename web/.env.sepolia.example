# Copy to web/.env.sepolia, fill values, then run:
#   npm run web:sepolia
#   npm run build:sepolia
# Do not commit web/.env.sepolia.

VITE_CHAIN_ID=11155111
VITE_RPC_URL=https://sepolia.infura.io/v3/<your-key>
VITE_CONTRACT_ADDRESS=0x<deployed-contract>
VITE_RELAY_URL=http://127.0.0.1:8787
VITE_HELPER_URL=http://127.0.0.1:8788
