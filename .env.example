# Stage 0 local test config — copy to .env and fill locally.
# .env is gitignored. Never commit real Steam IDs, trade URLs, or API keys.

STAGE0_SELLER_STEAM_ID=7656119xxxxxxxxxxxxx
STAGE0_SELLER_INVENTORY_URL=https://steamcommunity.com/inventory/<steamid64>/730/2?l=english&count=1000

# Seller Trade URL (PRIVATE; contains a token). NOT the inventory/profile URL.
# Format: https://steamcommunity.com/tradeoffer/new/?partner=<account_id>&token=<token>
STAGE0_SELLER_TRADE_URL=

STAGE0_BUYER_STEAM_ID=
STAGE0_BUYER_INVENTORY_URL=

# Plan A: buyer's PRIVATE Trade URL; the seller helper sends the offer to it.
# NOT the seller's Trade URL, and NOT an inventory/profile link.
STAGE0_BUYER_TRADE_URL=

# Optional, temporary only. Revoke after Stage 0.
STEAM_WEB_API_KEY=

STAGE0_ITEM_ASSET_ID=
STAGE0_ITEM_CLASS_ID=
STAGE0_ITEM_INSTANCE_ID=
STAGE0_ITEM_MARKET_HASH_NAME=
# Optional; copy from the item's "Inspect in Game" link in Steam
STAGE0_ITEM_INSPECT_LINK=
