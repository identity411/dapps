# SkinPact environment template. Copy to .env and fill values locally.
# NEVER commit .env, Steam Trade URLs/tokens, Steam sessions, or private keys.
#
# Generate the two Relay secrets once (do not reuse across machines):
#   JWT_SECRET=$(openssl rand -hex 32)
#   RELAY_ENCRYPTION_KEY=$(openssl rand -base64 32)
#
# ---------------------------------------------------------------------------
# Stage 1 — local Hardhat chain / Relay / helper
# ---------------------------------------------------------------------------

CHAIN_ID=31337
RPC_URL=http://127.0.0.1:8545

# Copy from deployments/local.json after `npm run deploy:local`.
# Leave empty until then; the Relay refuses to start without it.
CONTRACT_ADDRESS=

# Relay HTTP listener (bound to 127.0.0.1 by src/index.ts)
PORT=8787
WEB_ORIGIN=http://localhost:5173
DB_PATH=data/skinpact.db

# Both are REQUIRED and must be strong random values.
# JWT_SECRET >= 16 chars; RELAY_ENCRYPTION_KEY exactly 32 bytes, base64 or 64 hex.
JWT_SECRET=
RELAY_ENCRYPTION_KEY=

# Optional Relay tuning (defaults shown)
# DEPLOYMENT_BLOCK=0
# NONCE_TTL_SECONDS=300
# PAIRING_CODE_TTL_SECONDS=300
# HELPER_TOKEN_TTL_SECONDS=28800

# Contract constructor values used by `npm run deploy:local`
# (max 0.1 test ETH per listing; bond = max(minBond, price * 10%))
MAX_PRICE_ETH=0.1
MIN_BOND_ETH=0.001
OFFER_WINDOW_SECONDS=600
CHALLENGE_WINDOW_SECONDS=300

# Seller-local helper. The helper loads the same root .env via dotenv.
SKINPACT_RELAY_URL=http://127.0.0.1:8787
# SKINPACT_HELPER_DIR=helper/.skinpact-helper
# One-shot alternative to `npm run helper -- --pair <code>`; leave empty normally.
HELPER_PAIRING_CODE=

# Web uses Vite. It auto-reads deployments/local.json for the contract address.
# These overrides belong in web/.env (not the root .env) if you need them:
# VITE_CHAIN_ID=31337
# VITE_RPC_URL=http://127.0.0.1:8545
# VITE_RELAY_URL=http://127.0.0.1:8787
# VITE_CONTRACT_ADDRESS=0x...

# ---------------------------------------------------------------------------
# Stage 0 — standalone Steam feasibility demo only (scripts/stage0)
# Do not reuse these names for S1. Prefer empty unless running the Stage 0 demo.
# ---------------------------------------------------------------------------

STAGE0_SELLER_STEAM_ID=
STAGE0_SELLER_INVENTORY_URL=

# Seller Trade URL (PRIVATE; contains a token). NOT an inventory/profile URL.
# Format: https://steamcommunity.com/tradeoffer/new/?partner=<account_id>&token=<token>
STAGE0_SELLER_TRADE_URL=

STAGE0_BUYER_STEAM_ID=
STAGE0_BUYER_INVENTORY_URL=

# Plan A: buyer's PRIVATE Trade URL; the seller-local helper sends the offer.
# NOT the seller's Trade URL, and NOT an inventory/profile link.
STAGE0_BUYER_TRADE_URL=

# Optional, temporary only. Revoke after Stage 0.
STEAM_WEB_API_KEY=

STAGE0_ITEM_ASSET_ID=
STAGE0_ITEM_CLASS_ID=
STAGE0_ITEM_INSTANCE_ID=
STAGE0_ITEM_MARKET_HASH_NAME=
# Optional; copy from the item's "Inspect in Game" link in Steam
STAGE0_ITEM_INSPECT_LINK=
